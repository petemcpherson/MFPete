{
  "version" : 1,
  "rules" : [
    {
      "id" : "11111111-1111-1111-1111-111111111111",
      "name" : "Clean Downloads",
      "isEnabled" : true,
      "order" : 0,
      "scope" : [
        "~/Downloads"
      ],
      "trigger" : {
        "type" : "fileAdded"
      },
      "conditions" : {
        "match" : "all",
        "items" : [
          {
            "type" : "condition",
            "attribute" : "extension",
            "operator" : "isAnyOf",
            "value" : {
              "type" : "text",
              "text" : "dmg, zip"
            },
            "caseSensitive" : false
          },
          {
            "type" : "group",
            "match" : "any",
            "items" : [
              {
                "type" : "condition",
                "attribute" : "size",
                "operator" : "greaterThan",
                "value" : {
                  "type" : "size",
                  "amount" : 100,
                  "unit" : "mb"
                },
                "caseSensitive" : false
              },
              {
                "type" : "condition",
                "attribute" : "kind",
                "operator" : "is",
                "value" : {
                  "type" : "kind",
                  "kind" : "diskImage"
                },
                "caseSensitive" : false
              }
            ]
          }
        ]
      },
      "actions" : [
        {
          "type" : "trash"
        }
      ],
      "options" : {
        "includeSubfolders" : false,
        "includeHidden" : false,
        "stopOtherRules" : true,
        "notifyEachRun" : false
      },
      "notes" : "Keeps Downloads tidy.",
      "createdAt" : "2026-10-01T09:00:00Z",
      "modifiedAt" : "2026-10-01T09:30:00Z"
    },
    {
      "id" : "22222222-2222-2222-2222-222222222222",
      "name" : "Archive old screenshots",
      "isEnabled" : false,
      "order" : 1,
      "scope" : [
        "/Users/Shared/Screenshots"
      ],
      "trigger" : {
        "type" : "weekly",
        "weekdays" : [2, 4, 6],
        "hour" : 18,
        "minute" : 30
      },
      "conditions" : {
        "match" : "all",
        "items" : [
          {
            "type" : "condition",
            "attribute" : "name",
            "operator" : "startsWith",
            "value" : {
              "type" : "text",
              "text" : "Screenshot"
            },
            "caseSensitive" : false
          },
          {
            "type" : "condition",
            "attribute" : "dateAdded",
            "operator" : "notInTheLast",
            "value" : {
              "type" : "duration",
              "amount" : 3,
              "unit" : "days"
            },
            "caseSensitive" : false
          }
        ]
      },
      "actions" : [
        {
          "type" : "sortIntoSubfolder",
          "base" : "/Users/Shared/Screenshots/Archive",
          "pattern" : "{year}/{month}"
        },
        {
          "type" : "addTags",
          "tags" : ["Archived"]
        },
        {
          "type" : "move",
          "destination" : "/Users/Shared/Old",
          "onConflict" : "keepBoth"
        }
      ],
      "options" : {
        "includeSubfolders" : true,
        "includeHidden" : false,
        "stopOtherRules" : false,
        "notifyEachRun" : true
      },
      "notes" : "",
      "createdAt" : "2026-09-15T12:00:00Z",
      "modifiedAt" : "2026-09-15T12:00:00Z"
    }
  ]
}
